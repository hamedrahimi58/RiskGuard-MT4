//----------------------------------------------------
#define RG_COLOR_SUCCESS         clrLime
#define RG_COLOR_WARNING         clrGold
#define RG_COLOR_ERROR           clrRed

//----------------------------------------------------
// Edit Controls
//----------------------------------------------------
#define RG_COLOR_EDIT_BG         clrBlack
